# Example local configuration file for ParkNGo
# Copy this file to .env.mail.properties (or .env.local.properties) and update values.
# Files named .env* are gitignored and will never be committed.

# Enable real email dispatch
app.mail.enabled=false

# Gmail SMTP Credentials
# Note: For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
spring.mail.username=your-account@gmail.com
spring.mail.password=your-app-password

